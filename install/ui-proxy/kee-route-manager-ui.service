[Unit]
Description=Kee Route Manager UI proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kee-route-manager-ui ui-proxy --config /etc/kee-route-manager-ui/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/kee-route-manager-ui /var/lib/kee-route-manager-ui /var/cache/kee-route-manager-ui /run/kee-route-manager-ui

[Install]
WantedBy=multi-user.target
