[Unit]
Description=Kee Route Manager controller launcher
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=kee-route-manager
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/kee-route-manager-launcher serve --config /etc/kee-route-manager/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=70
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/kee-route-manager /var/lib/kee-route-manager /var/cache/kee-route-manager /run/kee-route-manager /etc/xray

[Install]
WantedBy=multi-user.target
