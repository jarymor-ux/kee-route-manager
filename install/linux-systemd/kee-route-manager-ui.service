[Unit]
Description=Kee Route Manager UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=kee-route-manager-ui
CacheDirectory=kee-route-manager-ui
RuntimeDirectory=kee-route-manager-ui
ExecStart=/usr/local/bin/kee-route-manager-ui serve --config /etc/kee-route-manager-ui/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/kee-route-manager-ui

[Install]
WantedBy=multi-user.target
