#!/bin/sh
### BEGIN INIT INFO
# Provides: kee-route-manager
# Required-Start: $network
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
### END INIT INFO
BIN=/opt/bin/kee-route-manager
CONFIG=/opt/etc/kee-route-manager/config.yaml
PIDFILE=/opt/var/run/kee-route-manager.pid
LOG=/opt/var/log/kee-route-manager.log
is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -d "/proc/$pid" ] || return 1
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    case "$exe" in "$BIN"|"$BIN (deleted)") true ;; *) false ;; esac
}
start() {
    if is_running; then echo "Kee Route Manager already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOG")"
    "$BIN" serve --config "$CONFIG" >>"$LOG" 2>&1 &
    pid=$!
    echo "$pid" >"$PIDFILE"
    sleep 2
    if ! is_running; then echo "Kee Route Manager failed to start; see $LOG" >&2; rm -f "$PIDFILE"; return 1; fi
    echo "Kee Route Manager started (pid $pid)"
}
stop() {
    if ! is_running; then rm -f "$PIDFILE"; echo "Kee Route Manager not running"; return 0; fi
    pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 20 ] && [ -d "/proc/$pid" ]; do sleep 1; i=$((i+1)); done
    if [ -d "/proc/$pid" ]; then kill -9 "$pid" 2>/dev/null || true; fi
    rm -f "$PIDFILE"
    echo "Kee Route Manager stopped"
}
case "${1:-}" in
  start) start;; stop) stop;; restart) stop; start;; status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi;; *) echo "Usage: $0 {start|stop|restart|status}"; exit 2;;
esac
